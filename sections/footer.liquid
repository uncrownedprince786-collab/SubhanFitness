<footer class="footer">
  <div class="footer__top">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="footer__brand" {{ block.shopify_attributes }}>
            {%- if settings.logo != blank -%}
              <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="150" height="45" style="filter:brightness(0) invert(1);margin-bottom:1.4rem;--logo-width:{{ settings.logo_width }}px;">
            {%- else -%}
              <p class="footer__brand-name">SUBHAN&nbsp;<span>FITNESS</span></p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}<p class="footer__desc">{{ block.settings.text }}</p>{%- endif -%}
            <ul class="footer__contact-list">
              {%- if block.settings.address != blank -%}<li>{% render 'icon', icon: 'shield' %}<span>{{ block.settings.address }}</span></li>{%- endif -%}
              {%- if block.settings.phone != blank -%}<li>{% render 'icon', icon: 'headset' %}<a href="tel:{{ block.settings.phone | replace: ' ', '' }}">{{ block.settings.phone }}</a></li>{%- endif -%}
              {%- if block.settings.email != blank -%}<li>{% render 'icon', icon: 'arrow-right' %}<a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>{%- endif -%}
            </ul>
            {%- if settings.social_whatsapp != blank -%}
              <a href="https://wa.me/{{ settings.social_whatsapp }}" class="footer__contact">{% render 'icon', icon: 'whatsapp' %} WhatsApp us</a>
            {%- endif -%}
            <div class="footer__social">
              {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">{% render 'icon', icon: 'facebook' %}</a>{%- endif -%}
              {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'icon', icon: 'instagram' %}</a>{%- endif -%}
              {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'icon', icon: 'tiktok' %}</a>{%- endif -%}
              {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">{% render 'icon', icon: 'youtube' %}</a>{%- endif -%}
            </div>
          </div>

        {%- when 'menu' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <p class="footer__col-title">{{ block.settings.heading }}</p>
            {%- assign fmenu = linklists[block.settings.menu] -%}
            <ul class="footer__links">
              {%- if fmenu.links.size > 0 -%}
                {%- for link in fmenu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {% render 'footer-default-links', set: block.settings.default_set %}
              {%- endif -%}
            </ul>
          </div>

        {%- when 'newsletter' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <p class="footer__col-title">{{ block.settings.heading }}</p>
            {%- if block.settings.text != blank -%}<p class="footer__desc">{{ block.settings.text }}</p>{%- endif -%}
            <div class="footer__newsletter">
              {%- form 'customer' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p style="color:#4ade80;">{{ 'general.newsletter_form.confirmation' | t }}</p>
                {%- else -%}
                  <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}" required>
                  <button type="submit" class="button button--full">{{ 'general.newsletter_form.button_label' | t }}</button>
                {%- endif -%}
              {%- endform -%}
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom">
    <div class="footer__bottom-inner">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</span>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="payment-icons">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% style %}
  .footer__contact { display: inline-flex; align-items: center; gap: .6rem; margin-bottom: 1rem; }
  .footer__contact .icon { width: 2rem; height: 2rem; }
  .footer__contact-list { margin: 1.4rem 0; display: flex; flex-direction: column; gap: .9rem; }
  .footer__contact-list li { display: flex; align-items: flex-start; gap: .8rem; font-size: 1.3rem; }
  .footer__contact-list .icon { width: 1.8rem; height: 1.8rem; color: var(--color-accent); flex-shrink: 0; margin-top: .2rem; }
  .payment-icons .payment-icon { height: 2.4rem; width: auto; }
{% endstyle %}

{% schema %}
{
  "name": "Footer",
  "blocks": [
    { "type": "brand", "name": "Brand & contact", "limit": 1,
      "settings": [
        { "type": "textarea", "id": "text", "label": "About text", "default": "Pakistan's home for premium fitness, gym & sports equipment. Train hard, live strong." },
        { "type": "text", "id": "address", "label": "Address" },
        { "type": "text", "id": "phone", "label": "Phone" },
        { "type": "text", "id": "email", "label": "Email" }
      ] },
    { "type": "menu", "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu (optional)", "info": "Leave empty to use built-in default links. Or create menus in Online Store → Navigation and select here." },
        { "type": "select", "id": "default_set", "label": "Default links (used when no menu selected)",
          "options": [
            { "value": "shop", "label": "Shop (categories)" },
            { "value": "help", "label": "Customer Service" },
            { "value": "company", "label": "Company" }
          ], "default": "shop" }
      ] },
    { "type": "newsletter", "name": "Newsletter column", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Newsletter" },
        { "type": "text", "id": "text", "label": "Text", "default": "Sign up for offers and training tips." }
      ] }
  ],
  "settings": [
    { "type": "text", "id": "copyright_text", "label": "Copyright text", "default": "All rights reserved." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ]
}
{% endschema %}
