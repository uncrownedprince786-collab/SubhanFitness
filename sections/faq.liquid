<section class="section">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <div class="section-title-center">
        {%- if section.settings.subheading != blank -%}<span class="section-eyebrow">{{ section.settings.subheading }}</span>{%- endif -%}
        <h2 class="h1">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="accordion faq-accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
          <summary class="accordion__summary">{{ block.settings.question }} {% render 'icon', icon: 'plus' %}</summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_contact_cta -%}
      <div class="text-center mt-3">
        <p>{{ section.settings.cta_text }}</p>
        <a href="{{ pages.contact.url | default: '/pages/contact' }}" class="button mt-2">{{ section.settings.cta_button | default: 'Contact us' }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} FAQ structured data for SEO (Google rich results) {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | strip_html | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% style %}
  .faq-accordion { border-top: 1px solid var(--color-border); }
  .faq-accordion .accordion__summary { font-family: var(--font-body-family); text-transform: none; font-size: 1.7rem; font-weight: 600; }
  .faq-accordion .accordion__content { font-size: 1.5rem; }
{% endstyle %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "Help Centre" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open first item by default", "default": true },
    { "type": "checkbox", "id": "show_contact_cta", "label": "Show 'still need help' CTA", "default": true },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Still have a question? Our team is happy to help." },
    { "type": "text", "id": "cta_button", "label": "CTA button label", "default": "Contact us" }
  ],
  "blocks": [
    {
      "type": "qa", "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question here?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Your answer here.</p>" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "How long does delivery take?", "answer": "<p>Orders are delivered within 2–5 working days across Pakistan. Orders placed before 2pm are usually dispatched the same day. You'll receive a tracking update as soon as your order ships.</p>" } },
        { "type": "qa", "settings": { "question": "Do you offer cash on delivery (COD)?", "answer": "<p>Yes. Cash on delivery is available nationwide. You can also pay online securely at checkout using your card.</p>" } },
        { "type": "qa", "settings": { "question": "What is your return and exchange policy?", "answer": "<p>We offer a 7-day easy exchange on unused items in their original packaging. Please see our Returns &amp; Exchange page for full details and how to start a return.</p>" } },
        { "type": "qa", "settings": { "question": "Is there a warranty on gym equipment?", "answer": "<p>Selected machines and equipment carry a manufacturer warranty. The warranty period is listed on each product page where applicable.</p>" } },
        { "type": "qa", "settings": { "question": "How do I choose the right equipment for my goals?", "answer": "<p>Browse by category — Strength &amp; Weights, Cardio Machines, Fitness Accessories, and more. If you're unsure, message us on WhatsApp and our team will recommend the best gear for your goals and space.</p>" } },
        { "type": "qa", "settings": { "question": "Do you deliver heavy items like treadmills?", "answer": "<p>Yes. Large items such as treadmills and multi-gyms are shipped with care via our courier partners. Delivery timelines for oversized items may vary slightly by city.</p>" } }
      ]
    }
  ]
}
{% endschema %}
