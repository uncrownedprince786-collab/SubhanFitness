<section class="section">
  <div class="page-width">
    <div class="{% if section.settings.center_heading %}section-title-center{% else %}section-header{% endif %}">
      <div class="section-header__text">
        {%- if section.settings.subheading != blank -%}<span class="section-eyebrow">{{ section.settings.subheading }}</span>{%- endif -%}
        <h2 class="{% if section.settings.center_heading %}h1{% else %}section-header__title h2{% endif %}">{{ section.settings.heading }}</h2>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="collection-list--tango scroll-carousel">
        {%- for block in section.blocks -%}
          {%- assign block_coll = block.settings.collection -%}
          {%- assign img = block.settings.image | default: block_coll.image -%}
          {%- assign use_icon = false -%}
          {%- if img == blank and block.settings.icon != 'none' -%}{%- assign use_icon = true -%}{%- endif -%}
          {%- assign title = block.settings.custom_title | default: block_coll.title | default: 'Category' -%}

          {%- if use_icon -%}
            <a href="{{ block_coll.url | default: '#' }}" class="collection-card collection-card--icon" {{ block.shopify_attributes }}>
              <span class="collection-card__media collection-card__media--icon">
                <span class="category-tile__icon">{% render 'icon', icon: block.settings.icon %}</span>
              </span>
              <span class="collection-card__caption">
                <span class="collection-card__title">{{ title }}</span>
                {% render 'icon', icon: 'chevron-right' %}
              </span>
            </a>
          {%- else -%}
            <a href="{{ block_coll.url | default: '#' }}" class="collection-card" {{ block.shopify_attributes }}>
              <span class="collection-card__media">
                {%- if img != blank -%}
                  <img src="{{ img | image_url: width: 600 }}" alt="{{ title | escape }}" loading="lazy" width="400" height="400">
                {%- elsif block_coll.products.first.featured_media -%}
                  <img src="{{ block_coll.products.first.featured_media | image_url: width: 600 }}" alt="{{ title | escape }}" loading="lazy" width="400" height="400">
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </span>
              <span class="collection-card__caption">
                <span class="collection-card__title">{{ title }}</span>
                {% render 'icon', icon: 'chevron-right' %}
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  /* Tango-style collection slider: square image tile with the label + chevron below.
     Scoped to .collection-list--tango so the /collections page (main-list-collections)
     keeps its original overlay card design. */
  .collection-list--tango { padding-bottom: .4rem; }
  .collection-list--tango.scroll-carousel { gap: 1.6rem; grid-auto-columns: 42%; }
  @media (min-width: 750px) { .collection-list--tango.scroll-carousel { grid-auto-columns: 22%; } }
  @media (min-width: 990px) { .collection-list--tango.scroll-carousel { grid-auto-columns: 12.5%; } }

  .collection-list--tango .collection-card {
    display: flex; flex-direction: column; gap: 1rem;
    aspect-ratio: auto; overflow: visible; background: transparent; border-radius: 0;
    box-shadow: none;
  }
  .collection-list--tango .collection-card:hover { transform: none; box-shadow: none; }
  .collection-list--tango .collection-card__media {
    display: block; width: 100%; aspect-ratio: 1 / 1; overflow: hidden;
    border-radius: var(--radius); background: var(--color-muted-bg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm); transition: box-shadow .28s var(--ease), transform .28s var(--ease);
  }
  .collection-list--tango .collection-card:hover .collection-card__media { box-shadow: var(--shadow-md); transform: translateY(-4px); }
  .collection-list--tango .collection-card__media img,
  .collection-list--tango .collection-card__media svg { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .collection-list--tango .collection-card:hover .collection-card__media img { transform: scale(1.06); }

  .collection-list--tango .collection-card__media--icon { display: flex; align-items: center; justify-content: center; }
  .collection-list--tango .category-tile__icon {
    display: flex; align-items: center; justify-content: center;
    width: 46%; height: 46%; border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent) 12%, #fff);
    color: var(--color-accent); transition: background .2s, color .2s;
  }
  .collection-list--tango .collection-card:hover .category-tile__icon { background: var(--color-accent); color: #fff; }
  .collection-list--tango .category-tile__icon .icon { display: inline-flex; width: 50%; height: 50%; }
  .collection-list--tango .category-tile__icon .icon svg { width: 100%; height: 100%; }

  .collection-list--tango .collection-card__caption {
    display: flex; align-items: center; justify-content: center; gap: .4rem;
    text-align: center; padding: 0 .4rem;
  }
  .collection-list--tango .collection-card__title {
    color: var(--color-heading); font-family: var(--font-heading-family); font-weight: 700;
    text-transform: uppercase; font-size: 1.3rem; letter-spacing: .02em; line-height: 1.2; margin: 0;
    transition: color .2s;
  }
  .collection-list--tango .collection-card:hover .collection-card__title { color: var(--color-accent); }
  .collection-list--tango .collection-card__caption .icon {
    display: inline-flex; width: 1.3rem; height: 1.3rem; color: var(--color-accent); flex: none;
    transition: transform .2s var(--ease);
  }
  .collection-list--tango .collection-card__caption .icon svg { width: 100%; height: 100%; }
  .collection-list--tango .collection-card:hover .collection-card__caption .icon { transform: translateX(3px); }
  @media (max-width: 749px) {
    .collection-list--tango .collection-card__title { font-size: 1.2rem; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "checkbox", "id": "center_heading", "label": "Center heading", "default": true },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Columns", "default": 4 },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true }
  ],
  "blocks": [
    {
      "type": "collection_item", "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "select", "id": "icon", "label": "Fitness icon (used when no image)", "default": "dumbbell",
          "options": [
            { "value": "none", "label": "None (use image/placeholder)" },
            { "value": "dumbbell", "label": "Dumbbell — Strength" },
            { "value": "treadmill", "label": "Treadmill — Cardio" },
            { "value": "kettlebell", "label": "Kettlebell" },
            { "value": "yoga", "label": "Yoga — Accessories" },
            { "value": "massage", "label": "Massage — Recovery" },
            { "value": "brace", "label": "Brace — Body Support" },
            { "value": "ball", "label": "Ball — Sports" },
            { "value": "gym-bag", "label": "Bag — Bags & Gear" },
            { "value": "tag", "label": "Tag — Sale" }
          ] },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional, overrides icon)" },
        { "type": "text", "id": "custom_title", "label": "Custom title (optional)" },
        { "type": "checkbox", "id": "show_count", "label": "Show count", "default": true }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection_item", "settings": { "icon": "dumbbell" } },
        { "type": "collection_item", "settings": { "icon": "treadmill" } },
        { "type": "collection_item", "settings": { "icon": "yoga" } },
        { "type": "collection_item", "settings": { "icon": "massage" } },
        { "type": "collection_item", "settings": { "icon": "brace" } },
        { "type": "collection_item", "settings": { "icon": "ball" } },
        { "type": "collection_item", "settings": { "icon": "gym-bag" } },
        { "type": "collection_item", "settings": { "icon": "tag" } }
      ]
    }
  ]
}
{% endschema %}
