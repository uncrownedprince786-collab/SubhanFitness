<slide-show class="slideshow" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}">
  <div class="slideshow__track">
    {%- for block in section.blocks -%}
      <div class="slideshow__slide" {{ block.shopify_attributes }}>
        <div class="slide__media ratio-{{ section.settings.height }}">
          {%- if block.settings.asset_image != blank -%}
            {%- comment -%} Branding image (background). Live text is rendered on top; a scrim hides the baked-in text. {%- endcomment -%}
            <img src="{{ block.settings.asset_image | asset_url }}"
                 sizes="100vw" alt="{{ block.settings.heading | default: shop.name | strip_html | escape }}"
                 width="2000" height="1117" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
            <div class="slide__scrim"></div>
          {%- elsif block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 2000 }}"
                 srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1500 }} 1500w, {{ block.settings.image | image_url: width: 2000 }} 2000w"
                 sizes="100vw" alt="{{ block.settings.heading | escape }}"
                 width="2000" height="750" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          {%- if block.settings.show_overlay -%}<div class="slide__overlay"></div>{%- endif -%}
        </div>
        <div class="slide__content align-{{ block.settings.text_align }}">
          {%- if block.settings.subheading != blank -%}<p class="slide__subheading">{{ block.settings.subheading }}</p>{%- endif -%}
          {%- if block.settings.heading != blank -%}<h2 class="slide__heading">{{ block.settings.heading }}</h2>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="slide__text">{{ block.settings.text }}</p>{%- endif -%}
          <div class="slide__buttons">
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link }}" class="button">{{ block.settings.button_label }}</a>
            {%- endif -%}
            {%- if block.settings.button_label_2 != blank -%}
              <a href="{{ block.settings.button_link_2 }}" class="button button--secondary" style="background:rgba(255,255,255,.9);border-color:transparent;color:#14181c;">{{ block.settings.button_label_2 }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button type="button" class="slideshow__arrow slideshow__arrow--prev" aria-label="{{ 'general.accessibility.previous' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
    <button type="button" class="slideshow__arrow slideshow__arrow--next" aria-label="{{ 'general.accessibility.next' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
    <div class="slideshow__controls">
      {%- for block in section.blocks -%}
        <button type="button" class="slideshow__dot {% if forloop.first %}active{% endif %}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</slide-show>

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "height", "label": "Height",
      "options": [ { "value": "wide", "label": "Wide (16:6)" }, { "value": "medium", "label": "Medium (16:8)" } ], "default": "wide" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Change slides every", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide", "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_image", "label": "Branding image (theme asset filename)", "info": "Full-bleed image shown uncropped, no text. Overrides Image. e.g. hero-subhan-branding.jpg" },
        { "type": "checkbox", "id": "show_overlay", "label": "Darken image for readable text", "default": true },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "New Season" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Gear Up For Greatness" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Premium fitness equipment, delivered nationwide." },
        { "type": "select", "id": "text_align", "label": "Text alignment",
          "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
        { "type": "text", "id": "button_label", "label": "Button 1 label", "default": "Shop Now" },
        { "type": "url", "id": "button_link", "label": "Button 1 link" },
        { "type": "text", "id": "button_label_2", "label": "Button 2 label" },
        { "type": "url", "id": "button_link_2", "label": "Button 2 link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [ { "type": "slide" }, { "type": "slide" } ]
    }
  ]
}
{% endschema %}
