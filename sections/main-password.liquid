<div class="password-page" style="min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:2rem;">
  <div style="max-width:44rem;">
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" width="180" height="54" style="margin:0 auto 2rem;--logo-width:180px;">
    {%- else -%}
      <p class="footer__brand-name" style="color:var(--color-heading);">SUBHAN&nbsp;<span style="color:var(--color-accent);">FITNESS</span></p>
    {%- endif -%}
    <h1 class="h2">{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    {%- form 'storefront_password' -%}
      <div class="newsletter__field" style="max-width:36rem;margin:2rem auto 0;">
        <input type="password" name="password" placeholder="Enter password" aria-label="Password" style="flex:1;padding:1.4rem;border:2px solid var(--color-border);border-radius:var(--radius);">
        <button type="submit" class="button">Enter</button>
      </div>
      {%- if form.errors -%}<p style="color:var(--color-sale);margin-top:1rem;">{{ form.errors.messages.form }}</p>{%- endif -%}
    {%- endform -%}
    <p style="margin-top:2rem;font-size:1.3rem;color:#6b7178;">Are you the store owner? <a href="/admin" style="color:var(--color-accent);">Log in here</a></p>
  </div>
</div>
{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening Soon" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We're getting our store ready. Enter the password to preview, or check back soon." }
  ]
}
{% endschema %}
