{%- liquid
  assign coll = section.settings.collection
  assign product_count = section.settings.products_to_show
  assign has_products = false
  if coll != blank and coll.products.size > 0
    assign has_products = true
  endif
-%}
{%- comment -%} The section always renders. When it has no products yet, a clean skeleton placeholder is shown (no fake prices/text on the live site); the editor additionally shows a hint. {%- endcomment -%}
<section class="section" style="{% if section.settings.background != blank %}background:{{ section.settings.background }};padding:var(--section-spacing) 0;{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.subheading != blank -%}<span class="section-eyebrow">{{ section.settings.subheading }}</span>{%- endif -%}
        <h2 class="section-header__title h2">{{ section.settings.heading | default: coll.title | default: 'Featured products' }}</h2>
      </div>
      {%- if section.settings.show_view_all and coll != blank -%}
        <a href="{{ coll.url }}" class="button button--secondary button--small section-header__cta">
          {{ 'sections.featured_collection.view_all' | t }} {% render 'icon', icon: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    {%- if has_products -%}
      {%- if section.settings.layout == 'carousel' -%}
        <div class="scroll-carousel">
          {%- for product in coll.products limit: product_count -%}
            {% render 'card-product', product: product %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="product-grid grid--{{ section.settings.products_per_row }}">
          {%- for product in coll.products limit: product_count -%}
            {% render 'card-product', product: product %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      {%- comment -%} Demo placeholder products shown until you assign a collection with real products. They are replaced automatically once the collection has products. {%- endcomment -%}
      {%- assign demo_titles = "Rubber Coated Dumbbells (Pack of 2)|Foldable Walking Pad|11-Piece Resistance Band Set|Handheld Massage Gun|Adjustable Kettlebell 2–16kg|Anti-Slip NBR Yoga Mat" | split: "|" -%}
      {%- assign demo_prices = "349900|8100000|149900|599900|1250000|389900" | split: "|" -%}
      {%- assign demo_compare = "480000|9500000|215000|0|0|535000" | split: "|" -%}
      {%- if section.settings.layout == 'carousel' -%}{%- assign demo_count = section.settings.products_to_show -%}{%- else -%}{%- assign demo_count = section.settings.products_per_row -%}{%- endif -%}
      <div class="{% if section.settings.layout == 'carousel' %}scroll-carousel{% else %}product-grid grid--{{ section.settings.products_per_row }}{% endif %}">
        {%- for i in (1..demo_count) -%}
          {%- assign idx = forloop.index0 | modulo: 6 -%}
          {%- assign dprice = demo_prices[idx] | plus: 0 -%}
          {%- assign dcompare = demo_compare[idx] | plus: 0 -%}
          <div class="card">
            <div class="card__badges">{%- if dcompare > dprice -%}<span class="badge badge--sale">Sale</span>{%- endif -%}</div>
            <span class="card__media ratio-square">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</span>
            <div class="card__content">
              <h3 class="card__title">{{ demo_titles[idx] }}</h3>
              <div class="card__price">
                {%- if dcompare > dprice -%}
                  <span class="price price--on-sale"><span class="price__sale">{{ dprice | money }}</span> <s class="price__compare">{{ dcompare | money }}</s></span>
                {%- else -%}
                  <span class="price"><span class="price__regular">{{ dprice | money }}</span></span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading (small label)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "select", "id": "layout", "label": "Layout",
      "options": [ { "value": "grid", "label": "Grid" }, { "value": "carousel", "label": "Carousel (scroll)" } ], "default": "carousel" },
    { "type": "range", "id": "products_per_row", "min": 2, "max": 5, "step": 1, "label": "Products per row (grid)", "default": 4 },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true },
    { "type": "color", "id": "background", "label": "Background color (optional)" }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
