<section class="section">
  <div class="page-width">
    <div class="image-with-text {% if section.settings.layout == 'image_right' %}image-with-text--reverse{% endif %}" style="background:{{ section.settings.background | default: 'transparent' }};">
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}"
               srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
               sizes="(min-width:990px) 50vw, 100vw" alt="{{ section.settings.heading | escape }}" loading="lazy" width="1200" height="800">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      <div class="image-with-text__content">
        {%- if section.settings.subheading != blank -%}<span class="card__vendor">{{ section.settings.subheading }}</span>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button mt-2">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  .image-with-text { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; border-radius: var(--radius); overflow: hidden; }
  .image-with-text--reverse .image-with-text__media { order: 2; }
  .image-with-text__media { border-radius: var(--radius); overflow: hidden; aspect-ratio: 4/3; }
  .image-with-text__media img { width: 100%; height: 100%; object-fit: cover; }
  .image-with-text__content { display: flex; flex-direction: column; gap: 1.2rem; padding: 1rem; }
  @media (max-width: 749px) { .image-with-text { grid-template-columns: 1fr; gap: 2rem; } .image-with-text--reverse .image-with-text__media { order: 0; } }
{% endstyle %}

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "layout", "label": "Image position",
      "options": [ { "value": "image_left", "label": "Left" }, { "value": "image_right", "label": "Right" } ], "default": "image_left" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Why Subhan Fitness" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for every level of athlete" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>From first-timers to pros, we stock the gear that helps you train smarter and reach your goals faster.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the range" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background" }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
