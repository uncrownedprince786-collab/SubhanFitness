{%- comment -%} Rendered via ?section_id=predictive-search for live search suggestions {%- endcomment -%}
<div data-predictive-inner>
  {%- if predictive_search.performed -%}
    {%- if predictive_search.resources.products.size == 0 and predictive_search.resources.collections.size == 0 and predictive_search.resources.pages.size == 0 -%}
      <p class="predictive-search__heading">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- else -%}
      {%- if predictive_search.resources.collections.size > 0 -%}
        <p class="predictive-search__heading">{{ 'general.search.collections' | t }}</p>
        {%- for collection in predictive_search.resources.collections -%}
          <a href="{{ collection.url }}" class="predictive-search__item">
            <span class="predictive-search__item-title">{{ collection.title }}</span>
          </a>
        {%- endfor -%}
      {%- endif -%}

      {%- if predictive_search.resources.products.size > 0 -%}
        <p class="predictive-search__heading">{{ 'general.search.products' | t }}</p>
        {%- for product in predictive_search.resources.products -%}
          <a href="{{ product.url }}" class="predictive-search__item">
            {%- if product.featured_media -%}
              <img class="predictive-search__image" src="{{ product.featured_media | image_url: width: 100 }}" alt="" width="50" height="50" loading="lazy">
            {%- endif -%}
            <span>
              <span class="predictive-search__item-title">{{ product.title }}</span><br>
              {% render 'price', product: product %}
            </span>
          </a>
        {%- endfor -%}
      {%- endif -%}

      {%- if predictive_search.resources.pages.size > 0 -%}
        <p class="predictive-search__heading">{{ 'general.search.pages' | t }}</p>
        {%- for page in predictive_search.resources.pages -%}
          <a href="{{ page.url }}" class="predictive-search__item"><span class="predictive-search__item-title">{{ page.title }}</span></a>
        {%- endfor -%}
      {%- endif -%}

      <a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}" class="button button--secondary button--full mt-2">
        {{ 'general.search.view_all' | t: terms: predictive_search.terms }}
      </a>
    {%- endif -%}
  {%- endif -%}
</div>
{% schema %}
{ "name": "Predictive search" }
{% endschema %}
