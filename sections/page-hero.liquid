{%- liquid
  assign heading = section.settings.heading | default: page.title | default: 'Page'
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}
<section class="page-hero {% if has_image %}page-hero--image{% endif %}" {% if has_image %}style="background-image:url('{{ section.settings.image | image_url: width: 2000 }}');"{% endif %}>
  {%- if has_image -%}<span class="page-hero__overlay"></span>{%- endif -%}
  <div class="page-width">
    {% render 'breadcrumbs' %}
    {%- if section.settings.subheading != blank -%}<span class="section-eyebrow">{{ section.settings.subheading }}</span>{%- endif -%}
    <h1 class="page-hero__title">{{ heading }}</h1>
    {%- if section.settings.intro != blank -%}<p class="page-hero__intro">{{ section.settings.intro }}</p>{%- endif -%}
  </div>
</section>

{% style %}
  .page-hero { position: relative; padding: 4.5rem 0; background: var(--color-muted-bg); overflow: hidden; }
  .page-hero--image { background-size: cover; background-position: center; padding: 7rem 0; color: #fff; }
  .page-hero--image .breadcrumbs, .page-hero--image .breadcrumbs a { color: rgba(255,255,255,.85); }
  .page-hero__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,8,7,.35), rgba(12,8,7,.65)); }
  .page-hero .page-width { position: relative; z-index: 1; }
  .page-hero__title { font-size: clamp(3rem, 5vw, 4.6rem); margin: .4rem 0 0; {% if has_image %}color:#fff;{% endif %} }
  .page-hero--image .section-eyebrow { color: #fff; }
  .page-hero__intro { max-width: 60rem; margin: 1.2rem 0 0; font-size: 1.7rem; {% if has_image %}color:rgba(255,255,255,.9);{% else %}color:var(--color-text);{% endif %} }
{% endstyle %}

{% schema %}
{
  "name": "Page hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Eyebrow / subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the page title if left blank." },
    { "type": "textarea", "id": "intro", "label": "Intro text" },
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" }
  ],
  "presets": [ { "name": "Page hero" } ]
}
{% endschema %}
