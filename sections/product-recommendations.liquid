<section class="section">
  <div class="page-width">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="section-header">
        <h2 class="section-header__title h2">{{ section.settings.heading }}</h2>
      </div>
      <div class="scroll-carousel">
        {%- for product in recommendations.products limit: section.settings.products_to_show -%}
          {% render 'card-product', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <product-recommendations
        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}">
      </product-recommendations>
      <script>
        (function () {
          var el = document.currentScript.previousElementSibling;
          if (!el || !el.dataset.url) return;
          fetch(el.dataset.url).then(function (r) { return r.text(); }).then(function (t) {
            var doc = new DOMParser().parseFromString(t, 'text/html');
            var fresh = doc.querySelector('.shopify-section');
            if (fresh) el.closest('.shopify-section, section').innerHTML = fresh.innerHTML;
          });
        })();
      </script>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "select", "id": "intent", "label": "Recommendation type",
      "options": [ { "value": "related", "label": "Related products" }, { "value": "complementary", "label": "Complementary products" } ],
      "default": "related" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 1, "label": "Products to show", "default": 8 }
  ]
}
{% endschema %}
