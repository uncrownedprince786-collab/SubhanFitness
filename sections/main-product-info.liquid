<section class="section">
  <div class="page-width">
    {% render 'breadcrumbs' %}
    <div class="product" id="ProductSection-{{ section.id }}">
      <div class="product__media-wrapper">
        {% render 'product-media-gallery', product: product %}
      </div>

      <div class="product__info" id="ProductInfo">
        <variant-selects data-section="ProductInfo" data-form-id="product-form-{{ section.id }}">
          <script type="application/json" data-variant-json>
            [
              {%- for variant in product.variants -%}
                {
                  "id": {{ variant.id }},
                  "options": {{ variant.options | json }},
                  "price": {{ variant.price }},
                  "compare_at_price": {{ variant.compare_at_price | default: 'null' }},
                  "available": {{ variant.available }},
                  "featured_media": {% if variant.featured_media %}{ "id": {{ variant.featured_media.id }} }{% else %}null{% endif %}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          </script>

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'vendor' -%}
                {%- if product.vendor != blank -%}
                  <span class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</span>
                {%- endif -%}

              {%- when 'title' -%}
                <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

              {%- when 'rating' -%}
                <div {{ block.shopify_attributes }}>{% render 'rating', product: product %}</div>

              {%- when 'price' -%}
                <div class="product__price" data-price-wrapper {{ block.shopify_attributes }}>
                  {% render 'price', product: product, use_variant: true, show_badge: true %}
                </div>
                {%- if product.compare_at_price > product.price -%}
                  {%- assign save = product.compare_at_price | minus: product.price | money -%}
                  <span class="product__save">{{ 'products.product.save' | t: amount: save }}</span>
                {%- endif -%}

              {%- when 'availability' -%}
                {%- assign v = product.selected_or_first_available_variant -%}
                <span class="product__availability {% if v.available %}in-stock{% else %}out-stock{% endif %}" data-availability {{ block.shopify_attributes }}>
                  <span class="dot"></span>
                  <span data-availability-text>{% if v.available %}{{ 'products.product.in_stock' | t }}{% else %}{{ 'products.product.out_of_stock' | t }}{% endif %}</span>
                </span>

              {%- when 'variant_picker' -%}
                <div {{ block.shopify_attributes }}>
                  {% render 'variant-picker', product: product, picker_type: block.settings.picker_type %}
                </div>

              {%- when 'buy_buttons' -%}
                {%- assign product_form_id = 'product-form-' | append: section.id -%}
                <div {{ block.shopify_attributes }}>
                  {% render 'buy-buttons', product: product, form_id: product_form_id, show_dynamic_checkout: block.settings.show_dynamic_checkout %}
                </div>

              {%- when 'icon_row' -%}
                <div class="product__icon-row" {{ block.shopify_attributes }}>
                  <div class="product__icon-item">{% render 'icon', icon: 'truck' %} <span>Delivery in 2-5 days</span></div>
                  <div class="product__icon-item">{% render 'icon', icon: 'refresh' %} <span>7-day exchange</span></div>
                  <div class="product__icon-item">{% render 'icon', icon: 'shield' %} <span>Secure checkout</span></div>
                </div>

              {%- when 'description' -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>

              {%- when 'specifications' -%}
                {%- assign specs = product.metafields.custom.specifications.value -%}
                {%- if specs != blank -%}
                  <div class="accordion" {{ block.shopify_attributes }}>
                    <details class="accordion__item" {% if block.settings.open_default %}open{% endif %}>
                      <summary class="accordion__summary">{{ 'products.product.specifications' | t }} {% render 'icon', icon: 'plus' %}</summary>
                      <div class="accordion__content">
                        {%- if specs.first -%}
                          <table class="spec-table">
                            {%- for row in specs -%}
                              <tr><th>{{ row.label | default: row[0] }}</th><td>{{ row.value | default: row[1] }}</td></tr>
                            {%- endfor -%}
                          </table>
                        {%- else -%}
                          <div class="rte">{{ specs }}</div>
                        {%- endif -%}
                      </div>
                    </details>
                  </div>
                {%- endif -%}

              {%- when 'share' -%}
                <div class="product__share" {{ block.shopify_attributes }}>
                  <button type="button" class="product__share-btn" onclick="navigator.share ? navigator.share({title: '{{ product.title | escape }}', url: window.location.href}) : navigator.clipboard.writeText(window.location.href)">
                    {% render 'icon', icon: 'share' %} <span>{{ block.settings.share_label | default: 'Share this product' }}</span>
                  </button>
                </div>

              {%- when '@app' -%}
                <div class="product__app-block" {{ block.shopify_attributes }}>{% render block %}</div>
            {%- endcase -%}
          {%- endfor -%}

          {%- comment -%} Shipping & Returns as static accordions (no collapsible_tab block; that block's schema was rejected by Shopify in this section). {%- endcomment -%}
          <div class="accordion">
            <details class="accordion__item">
              <summary class="accordion__summary">Shipping &amp; Delivery {% render 'icon', icon: 'plus' %}</summary>
              <div class="accordion__content rte">
                {%- if product.metafields.custom.shipping_info != blank -%}
                  {{ product.metafields.custom.shipping_info.value }}
                {%- else -%}
                  <p>Nationwide delivery in 2-5 working days. Cash on delivery available across Pakistan. Orders placed before 2pm are dispatched same day.</p>
                {%- endif -%}
              </div>
            </details>
          </div>
          <div class="accordion">
            <details class="accordion__item">
              <summary class="accordion__summary">Returns &amp; Warranty {% render 'icon', icon: 'plus' %}</summary>
              <div class="accordion__content rte">
                <p>7-day easy exchange on unused items in original packaging. Manufacturer warranty applies to equipment where stated.</p>
              </div>
            </details>
          </div>
        </variant-selects>
      </div>
    </div>
  </div>
</section>

{% style %}
  .product__icon-row { display: flex; flex-wrap: wrap; gap: 0; padding: 0; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; }
  .product__icon-item { flex: 1 1 0; min-width: 14rem; display: flex; align-items: center; gap: 1rem; font-size: 1.3rem; font-weight: 600; color: var(--color-heading); padding: 1.5rem 1.6rem; position: relative; }
  .product__icon-item:not(:last-child)::after { content: ""; position: absolute; right: 0; top: 24%; bottom: 24%; width: 1px; background: var(--color-border); }
  .product__icon-item .icon { width: 2.2rem; height: 2.2rem; color: var(--color-accent); flex-shrink: 0; }
  @media (max-width: 749px) { .product__icon-item { flex-basis: 100%; } .product__icon-item:not(:last-child)::after { top: auto; bottom: 0; left: 1.6rem; right: 1.6rem; width: auto; height: 1px; } }
  .product__share { margin-top: 1.6rem; }
  .product__share-btn { display: inline-flex; align-items: center; gap: .8rem; background: none; border: 0; padding: 0; cursor: pointer; font: inherit; font-weight: 600; color: var(--color-heading); }
  .product__share-btn:hover { color: var(--color-accent); }
  .product__share-btn .icon { display: inline-flex; width: 1.8rem; height: 1.8rem; color: var(--color-accent); flex-shrink: 0; }
  .product__share-btn .icon svg { width: 100%; height: 100%; }
{% endstyle %}

{% schema %}
{
  "name": "Product info v2",
  "tag": "section",
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "availability",
      "name": "Availability",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Type",
          "options": [
            {
              "value": "button",
              "label": "Swatch buttons"
            },
            {
              "value": "dropdown",
              "label": "Dropdown"
            }
          ],
          "default": "button"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout",
          "default": true
        }
      ]
    },
    {
      "type": "icon_row",
      "name": "Delivery & trust icons",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_delivery",
          "label": "Show delivery",
          "default": true
        },
        {
          "type": "text",
          "id": "delivery_text",
          "label": "Delivery text",
          "default": "Delivery in 2-5 days"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "specifications",
      "name": "Specifications",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "open_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "share_label",
          "label": "Label",
          "default": "Share this product"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "settings": []
}
{% endschema %}
