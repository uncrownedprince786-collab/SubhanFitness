<section class="section">
  <div class="page-width">
    <div class="section-title-center">
      <h1 class="h1">{{ section.settings.heading | default: 'Shop by category' }}</h1>
    </div>
    {%- liquid
      if section.settings.collections != blank
        assign collections_list = section.settings.collections
      else
        assign collections_list = collections
      endif
    -%}
    <div class="collection-list grid--{{ section.settings.columns }}">
      {%- for collection in collections_list -%}
        {%- if collection.handle != 'frontpage' and collection.all_products_count > 0 or section.settings.show_empty -%}
          <a href="{{ collection.url }}" class="collection-card">
            <div class="collection-card__media">
              {%- if collection.image -%}
                <img src="{{ collection.image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy" width="400" height="400">
              {%- elsif collection.products.first.featured_media -%}
                <img src="{{ collection.products.first.featured_media | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy" width="400" height="400">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>
            <div class="collection-card__overlay">
              <div>
                <h2 class="collection-card__title">{{ collection.title }}</h2>
                <span class="collection-card__count">{{ collection.all_products_count }} products</span>
              </div>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Columns", "default": 4 },
    { "type": "checkbox", "id": "show_empty", "label": "Show empty collections", "default": true },
    { "type": "collection_list", "id": "collections", "label": "Collections to show", "info": "Leave empty to show all collections automatically." }
  ]
}
{% endschema %}
