{%- liquid
  assign show_image = false
  if section.settings.show_collection_image and collection.image
    assign show_image = true
  endif
-%}
<section class="section section--tight">
  <div class="page-width">
    <div class="collection-banner {% if show_image %}collection-banner--with-image{% endif %}">
      {%- if show_image -%}
        <div class="collection-banner__media">
          <img src="{{ collection.image | image_url: width: 1600 }}"
               srcset="{{ collection.image | image_url: width: 800 }} 800w, {{ collection.image | image_url: width: 1600 }} 1600w"
               sizes="100vw" alt="{{ collection.title | escape }}" width="1600" height="500">
        </div>
      {%- endif -%}
      <div class="collection-banner__content">
        <h1 class="h1">{{ collection.title }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="rte collection-banner__desc">{{ collection.description }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_collection_image", "label": "Show collection image as background", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true }
  ]
}
{% endschema %}
