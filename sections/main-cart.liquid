<section class="section">
  <div class="page-width">
    <h1 class="h1">{{ 'sections.cart.title' | t }}</h1>

    <div data-cart-page>
      {%- if cart.item_count > 0 -%}
        <div class="cart-page">
          <div class="cart-page__items">
            {%- if settings.cart_show_free_shipping_bar and settings.cart_free_shipping_threshold > 0 -%}
              {%- assign threshold = settings.cart_free_shipping_threshold | times: 100 -%}
              {%- assign remaining = threshold | minus: cart.total_price -%}
              <div class="free-shipping-bar" style="margin-bottom:2rem;">
                <div class="free-shipping-bar__text">
                  {%- if remaining > 0 -%}{{ 'sections.cart.free_shipping_remaining_html' | t: amount: remaining | money }}
                  {%- else -%}{{ 'sections.cart.free_shipping_qualified' | t }}{%- endif -%}
                </div>
                <div class="free-shipping-bar__track">
                  {%- assign pct = cart.total_price | times: 100 | divided_by: threshold -%}
                  <div class="free-shipping-bar__fill" style="width: {% if pct > 100 %}100{% else %}{{ pct }}{% endif %}%"></div>
                </div>
              </div>
            {%- endif -%}

            {%- for item in cart.items -%}
              <div class="cart-page__row" data-cart-item>
                <a href="{{ item.url }}" class="cart-item__image">
                  {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" loading="lazy">{%- endif -%}
                </a>
                <div class="cart-item__details">
                  <p class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title }}</a></p>
                  {%- unless item.variant.title contains 'Default' -%}<p class="cart-item__variant">{{ item.variant.title }}</p>{%- endunless -%}
                  <p class="cart-item__variant">{{ item.final_price | money }} each</p>
                  <button type="button" class="cart-item__remove" data-cart-remove data-line="{{ forloop.index }}">{% render 'icon', icon: 'trash' %} {{ 'sections.cart.remove' | t }}</button>
                </div>
                <div class="quantity-input">
                  <button type="button" data-quantity-button="decrease" aria-label="{{ 'products.product.decrease_quantity' | t }}">−</button>
                  <input type="number" value="{{ item.quantity }}" min="0" data-cart-quantity data-line="{{ forloop.index }}" aria-label="{{ 'sections.cart.quantity' | t }}">
                  <button type="button" data-quantity-button="increase" aria-label="{{ 'products.product.increase_quantity' | t }}">+</button>
                </div>
                <div class="cart-item__price">
                  {%- if item.original_line_price > item.final_line_price -%}
                    <span class="price__sale">{{ item.final_line_price | money }}</span><br><s class="price__compare">{{ item.original_line_price | money }}</s>
                  {%- else -%}{{ item.final_line_price | money }}{%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>

          <aside class="cart-page__summary">
            <h2 class="h3">Order summary</h2>
            {%- if settings.cart_show_note -%}
              <label for="CartNote" style="font-weight:600;display:block;margin:1rem 0 .5rem;">{{ 'sections.cart.note' | t }}</label>
              <textarea id="CartNote" class="cart-note" data-cart-note rows="3" placeholder="{{ 'sections.cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
            {%- endif -%}
            <div class="cart-subtotal" style="margin-top:1.4rem;">
              <span class="cart-subtotal__label">{{ 'sections.cart.subtotal' | t }}</span>
              <span class="cart-subtotal__value">{{ cart.total_price | money }}</span>
            </div>
            <p class="cart-taxes">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>
            <form action="{{ routes.cart_url }}" method="post">
              <button type="submit" name="checkout" class="button button--full">{{ 'sections.cart.checkout' | t }}</button>
            </form>
            <a href="{{ routes.all_products_collection_url }}" class="button button--secondary button--full mt-2">{{ 'sections.cart.continue_shopping' | t }}</a>
          </aside>
        </div>
      {%- else -%}
        <div class="cart-empty">
          {% render 'icon', icon: 'cart' %}
          <h3>{{ 'sections.cart.empty' | t }}</h3>
          <p>{{ 'sections.cart.empty_subtext' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'sections.cart.continue_shopping' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Cart", "tag": "section", "settings": [] }
{% endschema %}
