{%- comment -%}
  Featured products — hand-pick any number of specific products to feature.
  Add a "Product" block for each product you want to show. Renders as a
  carousel (with prev/next arrows) or a grid. If no blocks are added yet,
  a clean skeleton placeholder is shown so the section never looks broken.
{%- endcomment -%}
<section class="section" style="{% if section.settings.background != blank %}background:{{ section.settings.background }};padding:var(--section-spacing) 0;{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.subheading != blank -%}<span class="section-eyebrow">{{ section.settings.subheading }}</span>{%- endif -%}
        <h2 class="section-header__title h2">{{ section.settings.heading | default: 'Featured products' }}</h2>
      </div>
      {%- if section.settings.show_view_all and section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="button button--secondary button--small section-header__cta">
          {{ 'sections.featured_collection.view_all' | t }} {% render 'icon', icon: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    {%- liquid
      assign has_any = false
      for block in section.blocks
        if block.settings.product != blank
          assign has_any = true
          break
        endif
      endfor
    -%}
    {%- if has_any -%}
      <div class="{% if section.settings.layout == 'carousel' %}scroll-carousel{% else %}product-grid grid--{{ section.settings.products_per_row }}{% endif %}">
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            <div {{ block.shopify_attributes }}>
              {% render 'card-product', product: block.settings.product %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%} Placeholder shown until you add product blocks in the theme editor. {%- endcomment -%}
      {%- if section.settings.layout == 'carousel' %}{% assign demo_count = 8 %}{% else %}{% assign demo_count = section.settings.products_per_row %}{% endif -%}
      <div class="{% if section.settings.layout == 'carousel' %}scroll-carousel{% else %}product-grid grid--{{ section.settings.products_per_row }}{% endif %}">
        {%- for i in (1..demo_count) -%}
          <div class="card">
            <span class="card__media ratio-square">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</span>
            <div class="card__content">
              <h3 class="card__title">Featured product</h3>
              <div class="card__price"><span class="price"><span class="price__regular">{{ 999900 | money }}</span></span></div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading (small label)", "default": "Handpicked" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "select", "id": "layout", "label": "Layout",
      "options": [ { "value": "carousel", "label": "Carousel (arrows)" }, { "value": "grid", "label": "Grid" } ], "default": "carousel" },
    { "type": "range", "id": "products_per_row", "min": 2, "max": 5, "step": 1, "label": "Products per row (grid)", "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": false },
    { "type": "url", "id": "view_all_link", "label": "'View all' link" },
    { "type": "color", "id": "background", "label": "Background color (optional)" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
