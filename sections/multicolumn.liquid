<section class="section" style="{% if section.settings.background != blank %}background:{{ section.settings.background }};padding:var(--section-spacing) 0;{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-title-center"><h2 class="h2">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="{% if section.settings.style == 'trust' %}trust-bar{% else %}multicolumn grid--{{ section.settings.columns }}{% endif %}">
      {%- for block in section.blocks -%}
        {%- if section.settings.style == 'trust' -%}
          <div class="trust-item" {{ block.shopify_attributes }}>
            {% render 'icon', icon: block.settings.icon %}
            <div>
              <p class="trust-item__title">{{ block.settings.title }}</p>
              <p class="trust-item__text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- else -%}
          <div class="multicolumn__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="60" height="60">
            {%- else -%}
              {% render 'icon', icon: block.settings.icon %}
            {%- endif -%}
            <h3 class="h4">{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Multicolumn / Trust",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "style", "label": "Style",
      "options": [ { "value": "trust", "label": "Trust bar (icon + text row)" }, { "value": "columns", "label": "Columns (centered)" } ], "default": "trust" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns (columns style)", "default": 3 },
    { "type": "color", "id": "background", "label": "Background", "default": "#f4f5f6" }
  ],
  "blocks": [
    {
      "type": "column", "name": "Column",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon",
          "options": [ {"value":"truck","label":"Truck"}, {"value":"shield","label":"Shield"}, {"value":"refresh","label":"Refresh"}, {"value":"headset","label":"Support"}, {"value":"check","label":"Check"}, {"value":"heart","label":"Heart"} ], "default": "truck" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides icon)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Fast delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "Nationwide in 2–5 days" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Trust bar",
      "settings": { "style": "trust" },
      "blocks": [
        { "type": "column", "settings": { "icon": "truck", "title": "Nationwide Delivery", "text": "Delivered in 2–5 days" } },
        { "type": "column", "settings": { "icon": "refresh", "title": "Easy Exchange", "text": "7-day hassle-free returns" } },
        { "type": "column", "settings": { "icon": "shield", "title": "Secure Checkout", "text": "Safe & encrypted payments" } },
        { "type": "column", "settings": { "icon": "headset", "title": "Expert Support", "text": "We're here to help" } }
      ]
    }
  ]
}
{% endschema %}
