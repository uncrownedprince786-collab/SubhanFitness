<article class="section">
  <div class="page-width page-width--narrow">
    {% render 'breadcrumbs' %}
    <h1 class="h1">{{ article.title }}</h1>
    <p class="card__vendor">{{ article.author }} · {{ article.published_at | date: '%d %B %Y' }}</p>
    {%- if article.image -%}
      <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title | escape }}" style="border-radius:var(--radius);margin:2rem 0;width:100%;" width="1400" height="700">
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>

    {%- if blog.comments_enabled? -%}
      <div class="mt-3">
        {%- if article.comments_count > 0 -%}
          <h2 class="h3">{{ article.comments_count }} comments</h2>
          {%- for comment in article.comments -%}
            <div style="padding:1.4rem 0;border-bottom:1px solid var(--color-border);">
              <p style="font-weight:600;">{{ comment.author }}</p>
              <div class="rte">{{ comment.content }}</div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>
{% schema %}
{ "name": "Article", "tag": "section", "settings": [] }
{% endschema %}
