<section class="section">
  <div class="page-width">
    <div class="section-title-center">
      <h1 class="h1">{{ 'general.search.search' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-field" style="max-width:600px;margin:0 auto;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="search-field__submit">{% render 'icon', icon: 'search' %}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="cart-empty">
          <h3>{{ 'general.search.no_results' | t: terms: search.terms }}</h3>
          <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'sections.cart.continue_shopping' | t }}</a>
        </div>
      {%- else -%}
        <div class="collection-toolbar">
          <span class="collection-toolbar__count">{{ search.results_count }} {{ 'general.search.results_with_count' | t: count: search.results_count }}</span>
          <label>
            <span class="visually-hidden">{{ 'products.facets.sort_by_label' | t }}</span>
            <select onchange="window.location.href=this.value">
              {%- assign terms_param = search.terms | url_encode -%}
              {%- assign base = '?q=' | append: terms_param | append: '&sort_by=' -%}
              {%- assign current = search.sort_by | default: 'relevance' -%}
              {%- for option in search.sort_options -%}
                <option value="{{ base }}{{ option.value }}" {% if option.value == current %}selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </label>
        </div>

        {%- paginate search.results by 24 -%}
          <div class="product-grid grid--4">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'card-product', product: item %}
              {%- else -%}
                <a href="{{ item.url }}" class="card">
                  <div class="card__content">
                    <span class="card__vendor">{{ item.object_type }}</span>
                    <h3 class="card__title">{{ item.title }}</h3>
                    {%- if item.content or item.excerpt -%}<p class="card__delivery">{{ item.excerpt | default: item.content | strip_html | truncatewords: 20 }}</p>{%- endif -%}
                  </div>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search results", "tag": "section", "settings": [] }
{% endschema %}
