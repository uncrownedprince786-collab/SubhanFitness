<section class="section">
  <div class="page-width">
    <h1>MINBODY {{ product.title }}</h1>
    {%- for block in section.blocks -%}{%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "rating", "name": "Rating", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "availability", "name": "Availability", "limit": 1 },
    {
      "type": "variant_picker", "name": "Variant picker", "limit": 1,
      "settings": [
        { "type": "select", "id": "picker_type", "label": "Type",
          "options": [ { "value": "button", "label": "Swatch buttons" }, { "value": "dropdown", "label": "Dropdown" } ],
          "default": "button" }
      ]
    },
    {
      "type": "buy_buttons", "name": "Buy buttons", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout (Buy it now)", "default": true }
      ]
    },
    {
      "type": "icon_row", "name": "Delivery & trust icons",
      "settings": [
        { "type": "checkbox", "id": "show_delivery", "label": "Show delivery", "default": true },
        { "type": "text", "id": "delivery_text", "label": "Delivery text", "default": "Delivery in 2–5 days" },
        { "type": "checkbox", "id": "show_returns", "label": "Show returns", "default": true },
        { "type": "text", "id": "returns_text", "label": "Returns text", "default": "7-day exchange" },
        { "type": "checkbox", "id": "show_secure", "label": "Show secure", "default": true },
        { "type": "text", "id": "secure_text", "label": "Secure text", "default": "Secure checkout" }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "specifications", "name": "Specifications (metafield)", "limit": 1,
      "settings": [ { "type": "checkbox", "id": "open_default", "label": "Open by default", "default": false } ] },
    {
      "type": "collapsible_tab", "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & Delivery" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Nationwide delivery in 2–5 working days. Cash on delivery available.</p>" },
        { "type": "text", "id": "metafield", "label": "Metafield key (custom namespace, optional)", "info": "e.g. shipping_info — overrides content if set on the product." },
        { "type": "checkbox", "id": "open_default", "label": "Open by default", "default": false }
      ]
    },
    { "type": "share", "name": "Share", "limit": 1,
      "settings": [ { "type": "text", "id": "share_label", "label": "Label", "default": "Share this product" } ] },
    { "type": "custom_liquid", "name": "Custom Liquid",
      "settings": [ { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid" } ] },
    { "type": "@app" }
  ],
  "settings": []
}
{% endschema %}
