<section class="section">
  <div class="page-width">
    <h1 class="h2">My account</h1>
    <div class="account-layout">
      <nav class="account-nav">
        <a href="{{ routes.account_url }}">Order history</a>
        <a href="{{ routes.account_addresses_url }}">Addresses</a>
        <a href="{{ routes.account_logout_url }}">Log out</a>
      </nav>
      <div>
        <h2 class="h3">Order history</h2>
        {%- paginate customer.orders by 12 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="account-table">
              <thead><tr><th>Order</th><th>Date</th><th>Payment</th><th>Fulfillment</th><th>Total</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}" class="link">{{ order.name }}</a></td>
                    <td>{{ order.created_at | date: '%d %b %Y' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_net_amount | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p>You haven't placed any orders yet.</p>
            <a href="{{ routes.all_products_collection_url }}" class="button mt-2">Start shopping</a>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
</section>
