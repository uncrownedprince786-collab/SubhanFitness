<section class="section">
  <div class="page-width">
    <div class="account-card">
      <h1 class="h2 text-center">Activate account</h1>
      <p class="text-center">Create your password to activate your account.</p>
      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}<div class="account-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label for="ActPassword">Password</label><input type="password" name="customer[password]" id="ActPassword" required></div>
        <div class="field"><label for="ActConfirm">Confirm password</label><input type="password" name="customer[password_confirmation]" id="ActConfirm" required></div>
        <button type="submit" class="button button--full">Activate account</button>
        <button type="submit" name="decline" class="button button--secondary button--full mt-2">Decline invitation</button>
      {%- endform -%}
    </div>
  </div>
</section>
