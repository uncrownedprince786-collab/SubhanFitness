<section class="section">
  <div class="page-width">
    <div class="account-card">
      <h1 class="h2 text-center">Create account</h1>
      {%- form 'create_customer' -%}
        {%- if form.errors -%}<div class="account-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label for="FirstName">First name</label><input type="text" name="customer[first_name]" id="FirstName"></div>
        <div class="field"><label for="LastName">Last name</label><input type="text" name="customer[last_name]" id="LastName"></div>
        <div class="field"><label for="RegEmail">Email</label><input type="email" name="customer[email]" id="RegEmail" required></div>
        <div class="field"><label for="RegPassword">Password</label><input type="password" name="customer[password]" id="RegPassword" required></div>
        <button type="submit" class="button button--full">Create account</button>
      {%- endform -%}
      <p class="text-center mt-3">Already have an account? <a href="{{ routes.account_login_url }}" class="link">Sign in</a></p>
    </div>
  </div>
</section>
