{%- comment -%}
  Renders variant option selectors as radio swatches.
  Must be placed inside a <variant-selects> element.
  Params: product, picker_type ('button' | 'dropdown')
{%- endcomment -%}
{%- unless product.has_only_default_variant -%}
  <div class="variant-picker">
    {%- for option in product.options_with_values -%}
      {%- assign option_index = forloop.index0 -%}
      <div class="variant-option" data-option-index="{{ option_index }}">
        <label class="variant-option__label">
          {{ option.name }}: <span data-selected-value="{{ option_index }}">{{ option.selected_value }}</span>
        </label>

        {%- if picker_type == 'dropdown' -%}
          <select class="variant-select">
            {%- for value in option.values -%}
              <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <div class="variant-swatches">
            {%- for value in option.values -%}
              {%- assign input_id = 'opt-' | append: option_index | append: '-' | append: forloop.index -%}
              <span class="variant-swatch">
                <input type="radio"
                       id="{{ input_id }}"
                       name="option-{{ option_index }}"
                       value="{{ value | escape }}"
                       data-variant-input
                       {% if option.selected_value == value %}checked{% endif %}>
                <label for="{{ input_id }}">{{ value }}</label>
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
{%- endunless -%}
