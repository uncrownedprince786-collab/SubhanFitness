{%- comment -%} Mobile navigation drawer — Subhan Fitness top categories. {%- endcomment -%}
{%- assign c = '/collections/' -%}
<div id="MenuDrawer" class="drawer menu-drawer" data-overlay="#MenuOverlay" aria-hidden="true" role="dialog" aria-label="Menu">
  <div class="drawer__header">
    <span class="drawer__title">Menu</span>
    <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
  </div>
  <div class="drawer__body">
    <nav class="menu-drawer__nav">
      <ul class="menu-drawer__list">
        <li><details><summary>Dumbbells &amp; Weights {% render 'icon', icon: 'caret' %}</summary>
          <div class="menu-drawer__sublist">
            <a href="{{ c }}dumbbells" class="menu-drawer__sublink">Dumbbells</a>
            <a href="{{ c }}adjustable-dumbbells" class="menu-drawer__sublink">Adjustable Dumbbells</a>
            <a href="{{ c }}kettlebells" class="menu-drawer__sublink">Kettlebells</a>
            <a href="{{ c }}barbells-plates" class="menu-drawer__sublink">Barbells &amp; Plates</a>
            <a href="{{ c }}weight-benches" class="menu-drawer__sublink">Weight Benches</a>
            <a href="{{ c }}power-racks" class="menu-drawer__sublink">Power Racks</a>
            <a href="{{ c }}weightlifting-belts" class="menu-drawer__sublink">Lifting Accessories</a>
            <a href="{{ c }}strength-weights" class="menu-drawer__sublink" style="color:var(--color-accent);font-weight:600;">Shop all →</a>
          </div>
        </details></li>
        <li><details><summary>Treadmills {% render 'icon', icon: 'caret' %}</summary>
          <div class="menu-drawer__sublist">
            <a href="{{ c }}treadmills" class="menu-drawer__sublink">Treadmills</a>
            <a href="{{ c }}walking-pads" class="menu-drawer__sublink">Walking Pads</a>
            <a href="{{ c }}elliptical-trainers" class="menu-drawer__sublink">Elliptical Trainers</a>
            <a href="{{ c }}rowing-machines" class="menu-drawer__sublink">Rowing Machines</a>
            <a href="{{ c }}steppers-aerobic" class="menu-drawer__sublink">Steppers &amp; Aerobic</a>
            <a href="{{ c }}treadmills" class="menu-drawer__sublink" style="color:var(--color-accent);font-weight:600;">Shop all →</a>
          </div>
        </details></li>
        <li><details><summary>Exercise Cycles {% render 'icon', icon: 'caret' %}</summary>
          <div class="menu-drawer__sublist">
            <a href="{{ c }}exercise-bikes" class="menu-drawer__sublink">Exercise Bikes</a>
            <a href="{{ c }}spin-bikes" class="menu-drawer__sublink">Spin Bikes</a>
            <a href="{{ c }}upright-bikes" class="menu-drawer__sublink">Upright Bikes</a>
            <a href="{{ c }}recumbent-bikes" class="menu-drawer__sublink">Recumbent Bikes</a>
            <a href="{{ c }}exercise-bikes" class="menu-drawer__sublink" style="color:var(--color-accent);font-weight:600;">Shop all →</a>
          </div>
        </details></li>
        <li><details><summary>Body Massagers {% render 'icon', icon: 'caret' %}</summary>
          <div class="menu-drawer__sublist">
            <a href="{{ c }}massage-guns" class="menu-drawer__sublink">Massage Guns</a>
            <a href="{{ c }}body-massagers" class="menu-drawer__sublink">Body Massagers</a>
            <a href="{{ c }}foot-leg-massagers" class="menu-drawer__sublink">Foot &amp; Leg Massagers</a>
            <a href="{{ c }}massage-chairs" class="menu-drawer__sublink">Massage Chairs</a>
            <a href="{{ c }}vibration-plates" class="menu-drawer__sublink">Vibration Plates</a>
            <a href="{{ c }}body-massagers" class="menu-drawer__sublink" style="color:var(--color-accent);font-weight:600;">Shop all →</a>
          </div>
        </details></li>
        <li><a href="{{ c }}trampolines" class="menu-drawer__link">Trampolines</a></li>
        <li><details><summary>Yoga &amp; Pilates {% render 'icon', icon: 'caret' %}</summary>
          <div class="menu-drawer__sublist">
            <a href="{{ c }}yoga-mats" class="menu-drawer__sublink">Yoga Mats</a>
            <a href="{{ c }}yoga-accessories" class="menu-drawer__sublink">Yoga Accessories</a>
            <a href="{{ c }}pilates-boards" class="menu-drawer__sublink">Pilates &amp; Push-up Boards</a>
            <a href="{{ c }}foam-rollers" class="menu-drawer__sublink">Foam Rollers</a>
            <a href="{{ c }}yoga-pilates" class="menu-drawer__sublink" style="color:var(--color-accent);font-weight:600;">Shop all →</a>
          </div>
        </details></li>
        <li><details><summary>Fitness Accessories {% render 'icon', icon: 'caret' %}</summary>
          <div class="menu-drawer__sublist">
            <a href="{{ c }}resistance-bands" class="menu-drawer__sublink">Resistance Bands</a>
            <a href="{{ c }}jump-ropes" class="menu-drawer__sublink">Jump Ropes</a>
            <a href="{{ c }}hand-grippers" class="menu-drawer__sublink">Hand Grippers</a>
            <a href="{{ c }}ab-core" class="menu-drawer__sublink">Ab &amp; Core Trainers</a>
            <a href="{{ c }}tummy-trimmers" class="menu-drawer__sublink">Tummy Trimmers</a>
            <a href="{{ c }}fitness-accessories" class="menu-drawer__sublink" style="color:var(--color-accent);font-weight:600;">Shop all →</a>
          </div>
        </details></li>
      </ul>
    </nav>
    <div style="padding:2rem;">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="button button--secondary button--full">{{ 'sections.header.account' | t }}</a>
      {%- endif -%}
      {%- if settings.social_whatsapp != blank -%}
        <a href="https://wa.me/{{ settings.social_whatsapp }}" class="button button--full mt-2" target="_blank" rel="noopener">Chat on WhatsApp</a>
      {%- endif -%}
    </div>
  </div>
</div>
<div id="MenuOverlay" class="drawer__overlay"></div>
