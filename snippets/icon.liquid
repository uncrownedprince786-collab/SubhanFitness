{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', icon: 'cart' %}
  Icons: search, cart, account, menu, close, caret, plus, minus, check, x,
  truck, shield, refresh, headset, star, star-outline, chevron-left, chevron-right,
  facebook, instagram, tiktok, youtube, whatsapp, arrow-right, filter, heart
{%- endcomment -%}
{%- liquid
  assign i = icon
-%}
<span class="icon icon-{{ i }}" aria-hidden="true">
{%- case i -%}
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
  {%- when 'cart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
  {%- when 'account' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  {%- when 'close' or 'x' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
  {%- when 'caret' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
  {%- when 'refresh' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
  {%- when 'headset' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 13v-1a8 8 0 0 1 16 0v1"/><path d="M4 13h3v6H5a1 1 0 0 1-1-1z"/><path d="M20 13h-3v6h2a1 1 0 0 0 1-1z"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6 6.6.6-5 4.3 1.5 6.5L12 16.9 5.9 19.4 7.5 13l-5-4.3 6.6-.6z"/></svg>
  {%- when 'chevron-left' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m15 6-6 6 6 6"/></svg>
  {%- when 'chevron-right' or 'arrow-right' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 6 6 6-6 6"/></svg>
  {%- when 'filter' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-4.5-9.5-9C1 9 2.5 5.5 6 5.5c2 0 3.2 1.2 4 2.3.8-1.1 2-2.3 4-2.3 3.5 0 5 3.5 3.5 6.5C19 16.5 12 21 12 21z"/></svg>
  {%- when 'share' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 10.5l6.8-4M8.6 13.5l6.8 4"/></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-2.2 0-3.5 1.3-3.5 3.5V11H8v3h2.5v7h3v-7H16l.5-3h-3V9.5c0-.3.2-.5.5-.5z"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 3c.3 2 1.6 3.5 3.5 3.8V9.5c-1.4 0-2.6-.4-3.6-1.1v6.2c0 3-2.2 5.4-5.2 5.4S5.5 17.6 5.5 14.6c0-2.7 2-4.9 4.6-5.3v2.8c-1 .3-1.8 1.2-1.8 2.4 0 1.4 1.1 2.5 2.4 2.5s2.4-1.1 2.4-2.5V3z"/></svg>
  {%- when 'youtube' -%}
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 8.2c-.2-1.4-.8-2.2-2.3-2.4C17.8 5.5 12 5.5 12 5.5s-5.8 0-7.7.3C2.8 6 2.2 6.8 2 8.2 1.8 9.6 1.8 12 1.8 12s0 2.4.2 3.8c.2 1.4.8 2.2 2.3 2.4 1.9.3 7.7.3 7.7.3s5.8 0 7.7-.3c1.5-.2 2.1-1 2.3-2.4.2-1.4.2-3.8.2-3.8s0-2.4-.2-3.8zM10 15V9l5 3z"/></svg>
  {%- when 'whatsapp' -%}
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.3A10 10 0 1 0 12 2zm5.3 14c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .3-3.3-.7s-3.8-3.4-3.9-3.6c-.1-.2-1-1.3-1-2.5s.6-1.8.8-2c.2-.2.5-.3.6-.3h.5c.2 0 .4 0 .6.5l.7 1.7c.1.1.1.3 0 .5l-.3.4c-.2.2-.3.3-.1.6.2.3.8 1.3 1.7 2 1.1.9 1.5 1 1.7 1.1s.4.1.5-.1l.7-.8c.2-.2.4-.2.5-.1l1.6.8c.2.1.4.2.4.3.1.2.1.8-.1 1.4z"/></svg>
  {%- when 'trash' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"/></svg>
  {%- when 'dumbbell' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M2 9v6M5 7v10M19 7v10M22 9v6M5 12h14"/></svg>
  {%- when 'treadmill' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="15" cy="4.5" r="1.6"/><path d="M8 21l2.5-5 3 2 1.5 4"/><path d="M10.5 16l-1-4 4-1.5 2.5 3H19"/><path d="M3 21h9l1-2H4.5A1.5 1.5 0 0 1 3 17.5V21z"/></svg>
  {%- when 'kettlebell' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 6a3 3 0 0 1 6 0c0 1.5-1 2-1 2 2 1 3.5 3 3.5 6a3.5 3.5 0 0 1-3.5 3.5h-4A3.5 3.5 0 0 1 6.5 14c0-3 1.5-5 3.5-6 0 0-1-.5-1-2z"/></svg>
  {%- when 'brace' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="6" y="3" width="12" height="18" rx="4"/><path d="M6 9h12M6 15h12M10 3v18M14 3v18"/></svg>
  {%- when 'massage' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M14 3l3 3-6 6-3-3z"/><path d="M11 9l-6 6a2 2 0 0 0 0 3 2 2 0 0 0 3 0l6-6"/><path d="M17 6h3M18.5 4.5v3"/></svg>
  {%- when 'ball' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M12 3c3 3 3 15 0 18M3 12h18M5 6c3 2 11 2 14 0M5 18c3-2 11-2 14 0"/></svg>
  {%- when 'gym-bag' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M3 9h18l-1 10H4z"/><path d="M8 9V7a4 4 0 0 1 8 0v2"/><path d="M9 9h6"/></svg>
  {%- when 'tag' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12l8-8h7v7l-8 8z"/><circle cx="14.5" cy="7.5" r="1.4" fill="currentColor" stroke="none"/></svg>
  {%- when 'yoga' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="4.5" r="1.8"/><path d="M12 7v6M4 21l5-3 3 .5 3-.5 5 3M6 12h12"/></svg>
{%- endcase -%}
</span>
