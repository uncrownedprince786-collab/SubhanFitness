{%- comment -%} Contextual breadcrumbs {%- endcomment -%}
<nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.aria_label' | t }}">
  <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
  {%- if request.page_type == 'product' -%}
    {%- if collection.url -%}
      <span class="sep">/</span><a href="{{ collection.url }}">{{ collection.title }}</a>
    {%- endif -%}
    <span class="sep">/</span><span aria-current="page">{{ product.title }}</span>
  {%- elsif request.page_type == 'collection' and collection.handle -%}
    <span class="sep">/</span><span aria-current="page">{{ collection.title }}</span>
  {%- elsif request.page_type == 'page' -%}
    <span class="sep">/</span><span aria-current="page">{{ page.title }}</span>
  {%- elsif request.page_type == 'article' -%}
    <span class="sep">/</span><a href="{{ blog.url }}">{{ blog.title }}</a>
    <span class="sep">/</span><span aria-current="page">{{ article.title }}</span>
  {%- endif -%}
</nav>
