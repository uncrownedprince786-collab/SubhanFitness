{%- comment -%} Product image gallery with thumbnails. Param: product {%- endcomment -%}
{%- liquid
  assign featured = product.selected_or_first_available_variant.featured_media | default: product.featured_media
-%}
<div class="product__media-gallery" data-media-gallery>
  <div class="product__media-main" data-main-media>
    {%- if featured -%}
      <img src="{{ featured | image_url: width: 900 }}"
           srcset="{{ featured | image_url: width: 600 }} 600w, {{ featured | image_url: width: 900 }} 900w, {{ featured | image_url: width: 1400 }} 1400w"
           sizes="(min-width: 990px) 50vw, 100vw"
           alt="{{ featured.alt | escape }}" width="900" height="900" id="MainProductImage">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>

  {%- if product.media.size > 1 -%}
    <div class="product__thumbnails">
      {%- for media in product.media -%}
        <button type="button"
                class="product__thumb {% if media.id == featured.id %}active{% endif %}"
                data-thumb
                data-media-id="{{ media.id }}"
                data-media-src="{{ media | image_url: width: 900 }}"
                aria-label="View image {{ forloop.index }}">
          <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" loading="lazy" width="80" height="80">
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
