{%- comment -%}
  Renders a price block for a product or variant.
  Params: product (or use variant), use_variant (bool), show_badge (bool)
{%- endcomment -%}
{%- liquid
  if use_variant and product.selected_or_first_available_variant
    assign target = product.selected_or_first_available_variant
    assign compare_at = target.compare_at_price
    assign price = target.price
  else
    assign target = product
    assign compare_at = product.compare_at_price
    assign price = product.price
  endif

  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif

  assign price_varies = false
  if product.price_varies and use_variant == false
    assign price_varies = true
  endif
-%}
<span class="price {% if on_sale %}price--on-sale{% endif %}">
  {%- if on_sale -%}
    {%- if price_varies -%}<span class="price__from">From</span>{%- endif -%}
    <span class="price__sale">{{ price | money }}</span>
    <s class="price__compare">{{ compare_at | money }}</s>
    {%- if show_badge -%}
      {%- assign pct = compare_at | minus: price | times: 100 | divided_by: compare_at -%}
      <span class="badge badge--sale">-{{ pct }}%</span>
    {%- endif -%}
  {%- else -%}
    {%- if price_varies -%}<span class="price__from">From</span>{%- endif -%}
    <span class="price__regular">{{ price | money }}</span>
  {%- endif -%}
</span>
