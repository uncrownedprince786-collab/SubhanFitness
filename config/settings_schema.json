[
  {
    "name": "theme_info",
    "theme_name": "Subhan Fitness",
    "theme_version": "1.0.0",
    "theme_author": "Subhan Fitness",
    "theme_documentation_url": "https://shopify.dev/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 150
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Brand tagline",
        "default": "Train Hard. Live Strong."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Primary"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent / brand color",
        "default": "#ff4d04"
      },
      {
        "type": "color",
        "id": "color_accent_dark",
        "label": "Accent (hover)",
        "default": "#d63e02"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text",
        "default": "#0c0807"
      },
      {
        "type": "color",
        "id": "color_heading",
        "label": "Headings",
        "default": "#0c0807"
      },
      {
        "type": "color",
        "id": "color_body_bg",
        "label": "Page background",
        "default": "#fbf7f1"
      },
      {
        "type": "color",
        "id": "color_muted_bg",
        "label": "Muted background",
        "default": "#f3ebe0"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders",
        "default": "#e7ddd0"
      },
      {
        "type": "header",
        "content": "Header"
      },
      {
        "type": "color",
        "id": "color_header_bg",
        "label": "Header background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_header_text",
        "label": "Header text",
        "default": "#14181c"
      },
      {
        "type": "header",
        "content": "Announcement bar"
      },
      {
        "type": "color",
        "id": "color_announcement_bg",
        "label": "Background",
        "default": "#0c0807"
      },
      {
        "type": "color",
        "id": "color_announcement_text",
        "label": "Text",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Footer"
      },
      {
        "type": "color",
        "id": "color_footer_bg",
        "label": "Footer background",
        "default": "#0c0807"
      },
      {
        "type": "color",
        "id": "color_footer_text",
        "label": "Footer text",
        "default": "#c9c3bd"
      },
      {
        "type": "header",
        "content": "Badges"
      },
      {
        "type": "color",
        "id": "color_sale_badge",
        "label": "Sale badge",
        "default": "#ff4d04"
      },
      {
        "type": "color",
        "id": "color_soldout_badge",
        "label": "Sold out badge",
        "default": "#8a8078"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "The theme uses a clean modern stack — Plus Jakarta Sans for headings and Inter for body text — loaded automatically. Adjust sizing below."
      },
      {
        "type": "range",
        "id": "font_body_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Body font size",
        "default": 100
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "min": 90,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Heading font size",
        "default": 110
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase",
        "label": "Uppercase headings",
        "default": true
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1400
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Space between sections",
        "default": 32
      },
      {
        "type": "range",
        "id": "grid_gap",
        "min": 8,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Grid gap",
        "default": 20
      },
      {
        "type": "select",
        "id": "corner_radius",
        "label": "Corner radius",
        "options": [
          { "value": "0px", "label": "Square" },
          { "value": "6px", "label": "Small" },
          { "value": "12px", "label": "Medium" },
          { "value": "20px", "label": "Large" }
        ],
        "default": "12px"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          { "value": "adapt", "label": "Adapt to image" },
          { "value": "square", "label": "Square (1:1)" },
          { "value": "portrait", "label": "Portrait (3:4)" }
        ],
        "default": "square"
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show product rating",
        "info": "Requires a product reviews app that sets rating metafields.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Show quick add button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_save_amount",
        "label": "Show discount percentage badge",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" },
          { "value": "notification", "label": "Popup notification" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Enable order note",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_free_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "range",
        "id": "cart_free_shipping_threshold",
        "min": 0,
        "max": 500000,
        "step": 500,
        "unit": "Rs",
        "label": "Free shipping threshold",
        "default": 15000
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "text", "id": "social_whatsapp", "label": "WhatsApp number", "info": "Include country code, e.g. 923001234567" }
    ]
  },
  {
    "name": "Cards & buttons",
    "settings": [
      {
        "type": "select",
        "id": "button_style",
        "label": "Button style",
        "options": [
          { "value": "solid", "label": "Solid" },
          { "value": "outline", "label": "Outline" }
        ],
        "default": "solid"
      }
    ]
  }
]
